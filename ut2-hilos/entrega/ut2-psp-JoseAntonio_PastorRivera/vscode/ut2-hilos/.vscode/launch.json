{
    "version": "0.2.0",
    "configurations": [
        {
            // F5 / "Run and Debug": arranca el menú en la terminal integrada (para poder escribir la opción)
            "type": "java",
            "name": "Menú UT2 (elegir ejercicio)",
            "request": "launch",
            "mainClass": "menu.Menu",
            "projectName": "ut2-hilos",
            "console": "integratedTerminal",
            "vmArgs": "-Dstdout.encoding=UTF-8"
        },
        {
            // Ejecutar directamente la clase que tengas abierta en el editor (si tiene main)
            "type": "java",
            "name": "Ejercicio abierto en el editor",
            "request": "launch",
            "mainClass": "${file}",
            "console": "integratedTerminal",
            "vmArgs": "-Dstdout.encoding=UTF-8"
        }
    ]
}
